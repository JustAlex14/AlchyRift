  "texts": [
    {
      "at": 40,
      "ticks": 110,
      "text": "AlchyRift",
      "style": "title",
      "color": "#B26BFF"
    },
    {
      "at": 210,
      "ticks": 110,
      "text": "They banished me. I went where no one would look: down.",
      "style": "caption"
    },
    {
      "at": 375,
      "ticks": 110,
      "text": "In a cave, something told me to dig deeper.",
      "style": "caption"
    },
    {
      "at": 740,
      "ticks": 100,
      "text": "So I built a door.",
      "style": "caption"
    },
    {
      "at": 905,
      "ticks": 110,
      "text": "Nothing grows in there. So I carry the world in.",
      "style": "caption"
    },
    {
      "at": 1595,
      "ticks": 110,
      "text": "Here, no one can send me away.",
      "style": "caption"
    },
    {
      "at": 2020,
      "ticks": 110,
      "text": "Something watches from the ceiling. I keep the water coming.",
      "style": "caption"
    },
    {
      "at": 2140,
      "ticks": 90,
      "text": "AlchyRift",
      "style": "title",
      "color": "#B26BFF"
    },
    {
      "at": 2160,
      "ticks": 70,
      "text": "I am happy here.",
